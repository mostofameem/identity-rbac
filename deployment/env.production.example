# Production Environment Configuration for RBAC Application
# Copy this file to .env and update with your actual values

# External PostgreSQL Database Configuration
DB_HOST=your-postgres-host.amazonaws.com
DB_PORT=5432
DB_USER=rbac_user
DB_PASSWORD=your_secure_database_password_here
DB_NAME=rbac_db
DB_SSL_MODE=require

# Application Configuration
HTTP_PORT=5001
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here_min_32_chars

# Environment
NODE_ENV=production
GO_ENV=production

# Mail Configuration (for user invitations and notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Security Settings
CORS_ALLOWED_ORIGINS=http://localhost,http://your-domain.com,https://your-domain.com
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Logging
LOG_LEVEL=info
LOG_FILE=/app/logs/application.log

# Health Check
HEALTH_CHECK_TIMEOUT=30s
